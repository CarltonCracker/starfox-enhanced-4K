# Asset-free regression: evaluate actual registration rules, not shader bodies.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
file(READ "${SOURCE_DIR}/CMakeLists.txt" root_rules)
if(NOT root_rules MATCHES "option\\(STARFOX_ENABLE_EXPERIMENTAL_REFLECTION_INDEX[ \t\r\n]+\"[^\"]*\"[ \t\r\n]+OFF\\)")
    message(FATAL_ERROR "Experimental reflection shaders must default OFF")
endif()
file(READ "${SOURCE_DIR}/cmake/DisplayXR.cmake" rules)
string(FIND "${rules}" "if(STARFOX_DXC AND STARFOX_ENABLE_EXPERIMENTAL_REFLECTION_INDEX)" first)
string(FIND "${rules}" "if(MINGW AND EXISTS" last)
if(first LESS 0 OR last LESS_EQUAL first)
    message(FATAL_ERROR "Reflection registration anchors changed")
endif()
math(EXPR length "${last}-${first}")
string(SUBSTRING "${rules}" ${first} ${length} registrations)
function(target_sources)
endfunction()
function(target_include_directories)
endfunction()
function(target_compile_definitions)
endfunction()
function(add_custom_command)
    get_property(count GLOBAL PROPERTY registration_count)
    math(EXPR count "${count}+1")
    set_property(GLOBAL PROPERTY registration_count ${count})
    if("${ARGN}" MATCHES "(^|;)-spirv(;|$)")
        get_property(spirv_count GLOBAL PROPERTY diagnostic_spirv_count)
        math(EXPR spirv_count "0${spirv_count}+1")
        set_property(GLOBAL PROPERTY diagnostic_spirv_count ${spirv_count})
    endif()
endfunction()
set(STARFOX_DXC unused-compiler)
foreach(enabled IN ITEMS OFF ON)
    set(STARFOX_ENABLE_EXPERIMENTAL_REFLECTION_INDEX ${enabled})
    set_property(GLOBAL PROPERTY registration_count 0)
    cmake_language(EVAL CODE "${registrations}")
    get_property(count GLOBAL PROPERTY registration_count)
    if(enabled AND NOT count EQUAL 42)
        message(FATAL_ERROR "Opt-in must retain all 42 source/capture shaders, got ${count}")
    elseif(NOT enabled AND NOT count EQUAL 0)
        message(FATAL_ERROR "Release registered ${count} experimental shaders")
    endif()
endforeach()
function(add_executable name)
    set_property(GLOBAL APPEND PROPERTY diagnostic_targets "${name}")
endfunction()
function(target_compile_features)
endfunction()
function(target_compile_options)
endfunction()
function(target_link_libraries)
endfunction()
function(target_link_options)
endfunction()
function(install)
endfunction()
string(FIND "${rules}" "if(STARFOX_BUILD_TOOLS AND STARFOX_DXR_ENABLED)" tools_first)
string(FIND "${rules}" "if(STARFOX_BUILD_TESTS)" tools_last)
if(tools_first LESS 0 OR tools_last LESS_EQUAL tools_first)
    message(FATAL_ERROR "Diagnostic registration anchors changed")
endif()
math(EXPR tools_length "${tools_last}-${tools_first}")
string(SUBSTRING "${rules}" ${tools_first} ${tools_length} tools_registrations)
set(STARFOX_BUILD_TOOLS ON)
set(STARFOX_DXR_ENABLED ON)
foreach(enabled IN ITEMS OFF ON)
    set(STARFOX_ENABLE_EXPERIMENTAL_REFLECTION_INDEX ${enabled})
    set_property(GLOBAL PROPERTY diagnostic_targets "")
    set_property(GLOBAL PROPERTY registration_count 0)
    set_property(GLOBAL PROPERTY diagnostic_spirv_count 0)
    cmake_language(EVAL CODE "${tools_registrations}")
    get_property(spirv_count GLOBAL PROPERTY diagnostic_spirv_count)
    get_property(targets GLOBAL PROPERTY diagnostic_targets)
    if(NOT "starfox_calibrated_scene_check" IN_LIST targets)
        message(FATAL_ERROR "Ordinary renderer diagnostics must remain available")
    endif()
    if(enabled AND NOT "starfox_reflected_visibility_index_check" IN_LIST targets)
        message(FATAL_ERROR "Explicit opt-in lost the standalone index diagnostic")
    elseif(NOT enabled AND (spirv_count GREATER 0 OR "starfox_reflected_visibility_index_check" IN_LIST targets))
        message(FATAL_ERROR "Default host tools unexpectedly compile experimental SPIR-V shaders")
    endif()
endforeach()
message(STATUS "Release excludes experimental shaders; explicit opt-in preserves all 42")
