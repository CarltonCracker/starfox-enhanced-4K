+#ifdef SDL_PLATFORM_WINRT
+/* WinRT's SDL_LoadObject uses LoadPackagedLibrary, which cannot load system
+ * DLLs. d3d12 and dxgi are linked directly instead, and the names this backend
+ * looks up resolve from a fixed table. dxgidebug and the PIX event runtime are
+ * not available to packaged apps, so those optional paths stay off.
+ */
+#undef USE_PIX_RUNTIME
+
+static HRESULT WINAPI D3D12_WINRT_CreateDXGIFactory1(const GUID *riid, void **ppFactory)
+{
+    return CreateDXGIFactory2(0, riid, ppFactory);
+}
+
+static SDL_SharedObject *D3D12_WINRT_LoadObject(const char *sofile)
+{
+    if (SDL_strcmp(sofile, D3D12_DLL) == 0 || SDL_strcmp(sofile, DXGI_DLL) == 0) {
+        return (SDL_SharedObject *)sofile;
+    }
+    SDL_SetError("%s is not available on WinRT", sofile);
+    return NULL;
+}
+
+static SDL_FunctionPointer D3D12_WINRT_LoadFunction(SDL_SharedObject *handle, const char *name)
+{
+    (void)handle;
+    if (SDL_strcmp(name, D3D12_CREATE_DEVICE_FUNC) == 0) {
+        return (SDL_FunctionPointer)D3D12CreateDevice;
+    }
+    if (SDL_strcmp(name, D3D12_SERIALIZE_ROOT_SIGNATURE_FUNC) == 0) {
+        return (SDL_FunctionPointer)D3D12SerializeRootSignature;
+    }
+    if (SDL_strcmp(name, D3D12_GET_DEBUG_INTERFACE_FUNC) == 0) {
+        return (SDL_FunctionPointer)D3D12GetDebugInterface;
+    }
+    if (SDL_strcmp(name, CREATE_DXGI_FACTORY1_FUNC) == 0) {
+        return (SDL_FunctionPointer)D3D12_WINRT_CreateDXGIFactory1;
+    }
+    return NULL;
+}
+
+static void D3D12_WINRT_UnloadObject(SDL_SharedObject *handle)
+{
+    (void)handle;
+}
+
+#define SDL_LoadObject   D3D12_WINRT_LoadObject
+#define SDL_LoadFunction D3D12_WINRT_LoadFunction
+#define SDL_UnloadObject D3D12_WINRT_UnloadObject
+#endif // SDL_PLATFORM_WINRT
